# Copy this file to .env and fill it in. Nothing here is required to run the
# API locally on testnet -- the defaults below already work out of the box.

# --- Money settings -----------------------------------------------------

X402_PAY_TO_ADDRESS=0x000000000000000000000000000000000000dEaD

# Price per successful /preview call. Deliberately lower than
# link-preview-api's $0.01 - see README for why that's sustainable (most
# requests are served from cache, not a fresh fetch).
X402_PRICE_USD=$0.003

# eip155:84532 = Base Sepolia -- TESTNET, fake money, safe default.
# eip155:8453  = Base mainnet -- REAL money.
X402_NETWORK=eip155:84532

# Used ONLY when CDP_API_KEY_ID/CDP_API_KEY_SECRET below are NOT set.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Coinbase Developer Platform (CDP) facilitator credentials. Required for
# Base mainnet (real money) and automatic x402 Bazaar listing. Setting BOTH
# switches the app to the CDP facilitator automatically (see app/payment.py).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

X402_SYNC_FACILITATOR_ON_START=true

# --- App settings ---------------------------------------------------------

APP_NAME=Link Preview Cache API
CONTACT_EMAIL=abstracttokengen@gmail.com
PREVIEW_TIMEOUT_SECONDS=8
PREVIEW_MAX_BYTES=2097152
PORT=8000

# --- Cache settings ---------------------------------------------------------

# SQLite file. Relative paths are resolved from the process's working
# directory (the Docker image runs from /app, so the default here becomes
# /app/data/cache.db - auto-created, no setup needed).
CACHE_DB_PATH=./data/cache.db

# How long a cached preview stays servable before the next request for that
# URL forces a fresh fetch. 6h default: long enough for same-day repeat
# lookups of a popular URL to mostly hit cache, short enough that stale OG
# metadata (a page's title/image changing) doesn't linger long.
CACHE_TTL_SECONDS=21600
