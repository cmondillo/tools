# Copy this file to .env and fill it in. Nothing here is required to run the
# API locally on testnet -- the defaults below already work out of the box.

# --- Money settings -----------------------------------------------------

# Wallet address that RECEIVES payments. This is the one thing you must set
# for real before this API can earn anything. Any Base-compatible EVM address
# works (e.g. from Coinbase Wallet / MetaMask). Defaults to the burn address
# so the demo is obviously not wired to anyone's real wallet.
X402_PAY_TO_ADDRESS=0x000000000000000000000000000000000000dEaD

# Price per successful /preview call (settled in USDC).
X402_PRICE_USD=$0.01

# CAIP-2 network id.
#   eip155:84532 = Base Sepolia -- TESTNET, fake money, safe default.
#   eip155:8453  = Base mainnet -- REAL money. Only switch this once
#                  X402_PAY_TO_ADDRESS is a wallet you actually control.
X402_NETWORK=eip155:84532

# Facilitator that verifies and settles payments on-chain on your behalf.
# Used ONLY when CDP_API_KEY_ID/CDP_API_KEY_SECRET below are NOT set.
#   https://x402.org/facilitator  -> free public testnet facilitator (default, no auth, no account)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Coinbase Developer Platform (CDP) facilitator credentials. Required for
# Base mainnet (real money) and for automatic x402 Bazaar listing. Free CDP
# account + API key: https://portal.cdp.coinbase.com
# Setting BOTH of these switches the app to the CDP facilitator automatically
# (see app/payment.py) - X402_FACILITATOR_URL above is then ignored. Leave
# both unset to keep using the free testnet facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Contact the facilitator on the first request to a paid route, to confirm
# it actually supports the configured network+scheme before quoting a price.
# /healthz and / are unaffected either way -- they never require payment, so
# they never touch the facilitator.
X402_SYNC_FACILITATOR_ON_START=true

# --- App settings ---------------------------------------------------------

APP_NAME=Link Preview API
PREVIEW_TIMEOUT_SECONDS=8
PREVIEW_MAX_BYTES=2097152
PORT=8000
